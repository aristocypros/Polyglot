# Secrets and credentials (generated by `make bootstrap`, never commit)
secrets/
*.pem
*.key
.env
.env.*
!.env.example

# Rust build output (Cargo.lock is committed: signer and pe-sim are binaries)
target/

# Go build output
api/bin/
*.exe
*.test
*.out

# Python
__pycache__/
*.py[cod]
.venv/

# Logs, OS and editor files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
