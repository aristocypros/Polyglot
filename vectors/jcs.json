{
  "description": "RFC 8785 JSON Canonicalization Scheme (JCS) test vectors and Polyglot envelope request body vectors",
  "standard_vectors": [
    {
      "id": "rfc8785_sec_3_2_2_primitives",
      "description": "RFC 8785 Section 3.2.2 primitive data types (numbers, string escapes, literals)",
      "input": {
        "numbers": [333333333.3333333, 1e30, 4.5, 0.002, 1e-27],
        "string": "\u20ac$\u000f\nA'B\"\\\"/",
        "literals": [null, true, false]
      },
      "canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\"/\"}"
    },
    {
      "id": "rfc8785_sec_3_2_3_property_sorting",
      "description": "RFC 8785 Section 3.2.3 lexicographical sorting of dictionary keys",
      "input": {
        "z": 1,
        "a": 2,
        "m": {
          "y": "nested_last",
          "b": "nested_first"
        }
      },
      "canonical": "{\"a\":2,\"m\":{\"b\":\"nested_first\",\"y\":\"nested_last\"},\"z\":1}"
    },
    {
      "id": "utf16_surrogate_vs_bmp_sorting",
      "description": "UTF-16 code unit ordering: supplementary characters (surrogate pairs 0xD800..0xDFFF like 😀 U+1F600) sort before high BMP characters (U+FFF0)",
      "input": {
        "\ufff0": "bmp_high",
        "\ud83d\ude00": "emoji_surrogate"
      },
      "canonical": "{\"😀\":\"emoji_surrogate\",\"\ufff0\":\"bmp_high\"}"
    },
    {
      "id": "forward_slash_not_escaped",
      "description": "Forward slash / must NOT be escaped in canonical JSON",
      "input": {
        "url": "https://example.com/api/v1/resource",
        "path": "m/44'/60'/0'/0/0"
      },
      "canonical": "{\"path\":\"m/44'/60'/0'/0/0\",\"url\":\"https://example.com/api/v1/resource\"}"
    },
    {
      "id": "control_characters_escaping",
      "description": "Control characters U+0000..U+001F must use shorthand (\\b,\\t,\\n,\\f,\\r) or \\u00xx",
      "input": {
        "ctrl": "\u0000\u0001\u0008\u0009\n\u000c\r\u001f"
      },
      "canonical": "{\"ctrl\":\"\\u0000\\u0001\\b\\t\\n\\f\\r\\u001f\"}"
    },
    {
      "id": "empty_structures",
      "description": "Empty objects and arrays serialize without whitespace",
      "input": {
        "arr": [],
        "obj": {}
      },
      "canonical": "{\"arr\":[],\"obj\":{}}"
    }
  ],
